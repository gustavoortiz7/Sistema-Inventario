# ===================================
# Sistema de Inventario - Configuración
# ===================================

# Puerto en el que corre el servidor
PORT=3000

# ===================================
# MongoDB Configuration
# ===================================

# Opción 1: Para MongoDB Local
MONGO_URI=mongodb://127.0.0.1:27017/sistema-inventario

# Opción 2: Para MongoDB Atlas (en la nube)
# MONGO_URI=mongodb+srv://usuario:contraseña@cluster0.xxxxx.mongodb.net/sistema-inventario?retryWrites=true&w=majority

# ===================================
# JWT Configuration
# ===================================

# Secreto para firmar tokens JWT
# ⚠️ CAMBIAR ESTO EN PRODUCCIÓN CON UNA CADENA SEGURA
# Generar: openssl rand -hex 32
JWT_SECRET=cambia_este_secreto_en_produccion

# Tiempo de expiración del token (en horas)
JWT_EXPIRES_IN=24

# ===================================
# Configuración del Administrador (Primera Vez)
# ===================================

# Estos valores se usan cuando ejecutas: npm run create-admin
# Luego puedes modificarlos en la aplicación
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@sistema.com
ADMIN_PASSWORD=admin123

# ===================================
# Environment
# ===================================

# development o production
NODE_ENV=development

# ===================================
# CORS Configuration
# ===================================

# Origen(es) permitidos para peticiones CORS
# En desarrollo: * (cualquier origen)
# En producción: https://tudominio.com
CORS_ORIGIN=*

# ===================================
# Archivos y Uploads
# ===================================

# Carpeta donde se guardan las imágenes subidas
UPLOADS_DIR=./uploads

# Tamaño máximo de archivo (en MB)
MAX_FILE_SIZE=5

# ===================================
# Logging
# ===================================

# Nivel de logging: debug, info, warn, error
LOG_LEVEL=info
